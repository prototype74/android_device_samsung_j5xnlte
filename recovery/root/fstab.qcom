# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                           <mnt_point>  <type>  <mnt_flags and options>                                              <fs_mgr_flags>
/dev/block/bootdevice/by-name/system             /system      ext4    ro,noload                                                            wait
/dev/block/bootdevice/by-name/userdata           /data        ext4    nosuid,nodev,noatime,noauto_da_alloc,discard,journal_async_commit    wait,check,encryptable=footer,length=-20480
/dev/block/bootdevice/by-name/userdata           /data        f2fs    nosuid,nodev,noatime,rw,inline_xattr                                 wait,check,encryptable=footer,length=-20480
/dev/block/bootdevice/by-name/cache              /cache       ext4    nosuid,nodev,noatime,noauto_da_alloc,discard,journal_async_commit    wait,check
/dev/block/bootdevice/by-name/cache              /cache       f2fs    nosuid,nodev,noatime,rw,inline_xattr                                 wait,check
/dev/block/bootdevice/by-name/misc               /misc        emmc    defaults                                                             defaults

# VOLD : msm8916_64
/dev/block/bootdevice/by-name/hidden             /preload     ext4    defaults        voldmanaged=preload:auto
/devices/platform/msm_hsusb_host/usb*            auto         auto    defaults        voldmanaged=usb:auto
