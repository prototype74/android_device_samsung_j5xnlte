# eMMC
/boot          emmc      /dev/block/bootdevice/by-name/boot          flags=display="Boot"
/system        ext4      /dev/block/bootdevice/by-name/system        flags=display="System"
/system_image  emmc      /dev/block/bootdevice/by-name/system
/cache         ext4      /dev/block/bootdevice/by-name/cache         flags=display="Cache"
/data          ext4      /dev/block/bootdevice/by-name/userdata      flags=display="Data";encryptable=footer;length=-20480
/recovery      emmc      /dev/block/bootdevice/by-name/recovery      flags=display="Recovery";backup=1
/efs           ext4      /dev/block/bootdevice/by-name/efs           flags=display="EFS";backup=1
/modemst1      emmc      /dev/block/bootdevice/by-name/modemst1      flags=subpartitionof=/efs;backup=1
/modemst2      emmc      /dev/block/bootdevice/by-name/modemst2      flags=subpartitionof=/efs;backup=1
/preload       ext4      /dev/block/bootdevice/by-name/hidden        flags=display="Preload";wipeingui;backup=1
/persist       ext4      /dev/block/bootdevice/by-name/persist       flags=display="Persist";backup=1
/misc          emmc      /dev/block/bootdevice/by-name/fota          flags=display="Misc"

# microSD
/boot_sdc2          emmc      /dev/block/platform/soc.0/7864900.sdhci/by-name/boot          flags=display="Boot (SDC2)";flashimg=1;backup=1;removable
/system_sdc2        ext4      /dev/block/platform/soc.0/7864900.sdhci/by-name/SYSTEM        flags=display="System (SDC2)";backup=1;wipeingui;removable
/system_image_sdc2  emmc      /dev/block/platform/soc.0/7864900.sdhci/by-name/SYSTEM        flags=display="System Image (SDC2)";flashimg=1;backup=1;removable
/cache_sdc2         ext4      /dev/block/platform/soc.0/7864900.sdhci/by-name/cache         flags=display="Cache (SDC2)";backup=1;wipeingui;removable
/data_sdc2          ext4      /dev/block/platform/soc.0/7864900.sdhci/by-name/userdata      flags=display="Data (SDC2)";encryptable=footer;length=-20480;removable
/vendor_sdc2        ext4      /dev/block/platform/soc.0/7864900.sdhci/by-name/vendor        flags=display="Vendor (SDC2)";backup=1;wipeingui;removable
/vendor_image_sdc2  emmc      /dev/block/platform/soc.0/7864900.sdhci/by-name/vendor        flags=display="Vendor Image (SDC2)";flashimg=1;backup=1;removable
/recovery_sdc2      emmc      /dev/block/platform/soc.0/7864900.sdhci/by-name/recovery      flags=display="Recovery (SDC2)";flashimg=1;backup=1;removable
/efs_sdc2           ext4      /dev/block/platform/soc.0/7864900.sdhci/by-name/efs           flags=display="EFS (SDC2)";backup=1;removable
/modemst1_sdc2      emmc      /dev/block/platform/soc.0/7864900.sdhci/by-name/modemst1      flags=subpartitionof=/efs_sdc2;backup=1;removable
/modemst2_sdc2      emmc      /dev/block/platform/soc.0/7864900.sdhci/by-name/modemst2      flags=subpartitionof=/efs_sdc2;backup=1;removable
/preload_sdc2       ext4      /dev/block/platform/soc.0/7864900.sdhci/by-name/hidden        flags=display="Preload (SDC2)";wipeingui;backup=1;removable
/persist_sdc2       ext4      /dev/block/platform/soc.0/7864900.sdhci/by-name/persist       flags=display="Persist (SDC2)";backup=1;removable
/misc_sdc2          emmc      /dev/block/platform/soc.0/7864900.sdhci/by-name/fota          flags=display="Misc (SDC2)";removable
/external_sd        auto      /data_sdc2/media/0                                            flags=display="MicroSD Card";usermrf;fsflags="bind";removable

/usb-otg       auto      /dev/block/sda1         /dev/block/sda               flags=display="USB OTG";storage;wipeingui;removable
